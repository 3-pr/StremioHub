+// ==================== Web Enhancer Helper Functions ====================
+
+function toggleApiKeyCards(source) {
+  const mdbCard     = document.getElementById('sh-mdblist-card');
+  const pubmetaCard = document.getElementById('sh-publicmetadb-card');
+  if (mdbCard)     mdbCard.classList.toggle('hidden',    source !== 'mdblist');
+  if (pubmetaCard) pubmetaCard.classList.toggle('hidden', source !== 'publicmetadb');
+}
+
+function testApiKey(source, key) {
+  const resultEl = document.getElementById('sh-api-test-result');
+  if (!key) {
+    if (resultEl) {
+      resultEl.style.display    = 'block';
+      resultEl.style.background = 'rgba(239,68,68,0.15)';
+      resultEl.style.color      = '#f87171';
+      resultEl.textContent      = 'أدخل المفتاح أولاً';
+      setTimeout(() => resultEl.style.display = 'none', 3000);
+    }
+    return;
+  }
+
+  const btn = source === 'mdblist'
+    ? document.getElementById('sh-test-mdblist')
+    : document.getElementById('sh-test-publicmetadb');
+  if (btn) { btn.textContent = '...'; btn.disabled = true; }
+
+  chrome.runtime.sendMessage({ type: 'TEST_RATINGS_API', source, apiKey: key }, (res) => {
+    if (btn) { btn.textContent = 'اختبار'; btn.disabled = false; }
+    if (!resultEl) return;
+    resultEl.style.display = 'block';
+    if (res?.ok) {
+      resultEl.style.background = 'rgba(16,185,129,0.15)';
+      resultEl.style.color      = '#34d399';
+      resultEl.textContent      = `✓ يعمل — ${res.count} مصادر تقييم`;
+    } else {
+      resultEl.style.background = 'rgba(239,68,68,0.15)';
+      resultEl.style.color      = '#f87171';
+      resultEl.textContent      = `✗ خطأ: ${res?.error || 'لا يوجد رد'}`;
+    }
+    setTimeout(() => resultEl.style.display = 'none', 5000);
+  });
+}
+
+function broadcastStyleUpdate(payload) {
+  // إرسال التحديث لكل تبويبات Stremio Web المفتوحة
+  chrome.tabs.query({ url: '*://web.stremio.com/*' }, (tabs) => {
+    tabs.forEach((tab) => {
+      chrome.tabs.sendMessage(tab.id, {
+        type: 'UPDATE_WEB_STYLE',
+        ...payload
+      }).catch(() => { /* التبويب ربما لم يُحمَّل الـ content script بعد */ });
+    });
+  });
+}
